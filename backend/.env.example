# ============================================================
# Bus Ticket Reservation System — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bus-reservation?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_random_secret_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ── SMTP / Email (Gmail example) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=BusGo <your_email@gmail.com>

# ── CORS ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
